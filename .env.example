APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# درگاه پیامک: shina | melipayamak (اولویت با تنظیمات ادمین است)
SMS_PROVIDER=shina
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_FROM=30008810852036
MELIPAYAMAK_OTP_BODY_ID=564703
# code | shop_code
MELIPAYAMAK_OTP_VARS_MODE=shop_code

# تست جریان حسابداری (اختیاری؛ خالی = endpoint عمومی همیشه 403)
ACCOUNTING_FLOW_TEST_KEY=
ACCOUNTING_FLOW_TEST_ALLOW_PRODUCTION=false

# پروکسی‌های قابل اعتماد برای IP واقعی (throttle)
# خالی در کد = 127.0.0.1,::1 | *=همه (فقط وقتی سرور مستقیم در اینترنت نیست)
TRUSTED_PROXIES=127.0.0.1,::1

# CORS — برند (webinoo-plus + webino-plus + webinoplus) همیشه مجاز است
# خالی = برند + لوکال | *=باز | لیست با ویرگول = اضافه بر برند
CORS_ALLOWED_ORIGINS=
CORS_EXTRA_ORIGINS=https://omidtamir.ir,https://www.omidtamir.ir
# خالی مطلق = بدون الگو | تنظیم‌نشده = الگوهای برند
# CORS_ALLOWED_ORIGIN_PATTERNS=
